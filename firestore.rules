rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow public read and write for the festival app collections.
    // Festival participants access the web app anonymously via mobile browsers.
    match /settings/{docId} {
      allow read, write: if true;
    }

    match /booths/{boothId} {
      allow read, write: if true;
    }

    match /participants/{participantId} {
      allow read, write: if true;
    }

    match /logs/{logId} {
      allow read, write: if true;
    }
  }
}
